---
layout: default
---
<style>
  @import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Spectral:wght@400;500;600&display=swap");

  .post {
    font-family: "Spectral", Georgia, serif;
  }

  .post .post-header {
    margin-bottom: 0.9rem;
  }

  .post .post-title {
    font-family: "Cinzel", "Times New Roman", serif;
    font-size: clamp(2.45rem, 4.4vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.25rem;
    line-height: 1.08;
  }

  .post .home-email {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1rem, 1.55vw, 1.16rem);
    letter-spacing: 0.045em;
    margin-bottom: 0.58rem;
    color: var(--global-theme-color);
    line-height: 1.3;
  }

  .post .desc {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.14rem, 1.7vw, 1.32rem);
    font-weight: 500;
    max-width: 52rem;
    margin: 0;
    color: var(--global-text-color-light);
    line-height: 1.44;
  }

  .post .profile.float-right {
    width: 23%;
    margin-left: 1.3rem;
    margin-top: 0;
  }

  .post .profile img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 42%;
    border-radius: 14px;
    border: 1px solid var(--global-divider-color);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
  }

  .post .profile figure {
    margin-top: 0;
    margin-bottom: 0.85rem;
  }

  .post .profile .more-info {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.03rem;
    line-height: 1.3;
    margin-top: 0.55rem;
  }

  .home-overview {
    max-width: 53rem;
    margin-top: 0;
  }

  .home-overview p {
    font-size: clamp(1.03rem, 1.35vw, 1.12rem);
    margin-bottom: 0.72rem;
    line-height: 1.45;
  }

  .home-research {
    max-width: 53rem;
    margin-top: 0.62rem;
    padding: 0.62rem 0.7rem 0.55rem 0.7rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 12px;
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.01));
  }

  .home-research h2 {
    font-family: "Cinzel", "Times New Roman", serif;
    margin-bottom: 0.42rem;
    font-size: clamp(1.06rem, 1.5vw, 1.24rem);
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  .home-research .interest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.55rem 0.7rem;
    margin-bottom: 0;
    padding-left: 0;
    list-style: none;
  }

  .home-research .interest-item {
    padding: 0.56rem 0.62rem 0.58rem 0.68rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.03);
    min-height: 72px;
  }

  .home-research .interest-index {
    display: block;
    font-family: "Cinzel", "Times New Roman", serif;
    letter-spacing: 0.04em;
    color: var(--global-theme-color);
    font-size: 0.82rem;
    line-height: 1.1;
    margin-bottom: 0.22rem;
  }

  .home-research .interest-label {
    display: block;
    font-family: "Spectral", Georgia, serif;
    color: var(--global-text-color);
    font-size: clamp(0.95rem, 1.12vw, 1rem);
    line-height: 1.32;
  }

  @media (max-width: 575.98px) {
    .post .profile.float-right,
    .post .profile.float-left {
      width: 100%;
      margin-right: 0;
      margin-left: 0;
    }

    .home-research .interest-grid {
      grid-template-columns: 1fr;
    }

    .post .post-title {
      letter-spacing: 0.01em;
    }
  }
</style>
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if site.data.socials.email %}
      <p class="home-email">{{ site.data.socials.email }}</p>
    {% endif %}
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    <p class="desc">{{ page.subtitle | default: site.description }}</p>
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
